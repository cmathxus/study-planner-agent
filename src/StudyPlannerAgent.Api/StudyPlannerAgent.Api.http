@StudyPlannerAgent.Api_HostAddress = http://localhost:5090

### Register
# @name register
POST {{StudyPlannerAgent.Api_HostAddress}}/auth/register
Content-Type: application/json

{
  "name": "Caio Matheus",
  "email": "caio@example.com",
  "password": "password123"
}

###

@token = {{register.response.body.$.access_token}}

GET {{StudyPlannerAgent.Api_HostAddress}}/auth/me
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{StudyPlannerAgent.Api_HostAddress}}/study-plan/today
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{StudyPlannerAgent.Api_HostAddress}}/study-plan/week
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{StudyPlannerAgent.Api_HostAddress}}/study-topics
Authorization: Bearer {{token}}
Accept: application/json

###

# @name createTopic
POST {{StudyPlannerAgent.Api_HostAddress}}/study-topics
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "EF Core",
  "description": "Estudar migrations, relacionamentos e tracking.",
  "weekday": "Friday"
}

###

@topicId = {{createTopic.response.body.$.id}}

PUT {{StudyPlannerAgent.Api_HostAddress}}/study-topics/{{topicId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "EF Core",
  "description": "Estudar migrations, tracking e queries.",
  "weekday": "Saturday"
}

###

DELETE {{StudyPlannerAgent.Api_HostAddress}}/study-topics/{{topicId}}
Authorization: Bearer {{token}}
Accept: application/json

###

POST {{StudyPlannerAgent.Api_HostAddress}}/progress
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "topic_id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaa1",
  "percentage": 20,
  "notes": "Revisei LINQ e async/await."
}

###

GET {{StudyPlannerAgent.Api_HostAddress}}/progress/summary
Authorization: Bearer {{token}}
Accept: application/json
